def load_quote_cache():
    """Load cached quotes (fallback)"""
    cache_file = "/home/claude/quote_cache.json"
    if os.path.exists(cache_file):
        try:
            with open(cache_file, "r") as f:
                return json.load(f)
        except:
            pass
    return {}
 
def update_quote_cache(quotes):
    """Save quotes to cache"""
    cache_file = "/home/claude/quote_cache.json"
    try:
        os.makedirs(os.path.dirname(cache_file), exist_ok=True)
        with open(cache_file, "w") as f:
            json.dump(quotes, f)
        return True
    except:
        return False
 
def get_quotes_with_metadata():
