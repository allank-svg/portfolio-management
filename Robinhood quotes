    quotes = fetch_robinhood_quotes_live()
 
    # Add metadata
    metadata = {
        'timestamp': datetime.now().isoformat(),
        'source': 'robinhood_api',  # or 'cache' if using fallback
        'quote_count': len(quotes),
    }
 
    return quotes, metadata
 
